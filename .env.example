# Environment Variables — Hostel Complaint Management System
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file (it's in .gitignore)

# ─── PostgreSQL Database ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hostel_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# ─── JWT Secret ─────────────────────────────────────────────
# Use a long random string (min 32 chars) for production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION_MS=86400000

# ─── Spring Boot Server ─────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ─── Frontend ───────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api

# ─── Docker Registry (for Task 12) ──────────────────────────
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=your_dockerhub_username
DOCKER_IMAGE_NAME=hostel-cms
DOCKER_IMAGE_TAG=latest

# ─── Ansible (for Task 13-14) ───────────────────────────────
ANSIBLE_TARGET_HOST=localhost
ANSIBLE_USER=ubuntu
